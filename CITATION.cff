    given-names: Ilian
    orcid: "https://orcid.org/0000-0003-3779-4281"
version: 0.1.0
license: MIT
repository-code: "https://github.com/IlianPihlajamaa/CubatureRules.jl"
url: "https://ilianpihlajamaa.github.io/CubatureRules.jl/stable/"
keywords:
  - quadrature
  - cubature
  - numerical integration
  - arbitrary precision
  - Julia
